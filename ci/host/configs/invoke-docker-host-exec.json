{
  "imageName": "sqlserver-instance",
  "containerName": "sqlserver-provision",
  "serviceName": "dbe14",
  "runStampFormat": "yyyyMMdd-HHmmss",
  "containerScriptPath": "C:\\sqlserver\\scripts\\ci-host-bind-mount.ps1",
  "hostBindMountFolderName": "host_bind_mount",
  "payloadRelativePath": "..\\..\\..\\src\\sqlserver",
  "logFolderName": "logs",
  "bindMounts": [
    {
      "name": "logs",
      "containerPath": "C:\\Program Files\\Microsoft SQL Server\\170\\Setup Bootstrap\\Log",
      "readOnly": false,
      "tail": true,
      "logFilter": "Summary.txt"
    },
    {
      "name": "media",
      "containerPath": "C:\\host_bind_mount",
      "readOnly": true,
      "tail": false,
      "logFilter": ""
    },
    {
      "name": "payload",
      "containerPath": "C:\\sqlserver",
      "readOnly": true,
      "tail": false,
      "logFilter": ""
    }
  ],
  "logTailFiles": 3,
  "probes": [
    { "probeType": "service", "value": "MSSQLSERVER" },
    { "probeType": "service", "value": "MsDtsServer170" },
    { "probeType": "service", "value": "PowerBIReportServer" },
    { "probeType": "path", "value": "C:\\Program Files\\Microsoft Power BI Report Server\\PBIRS\\ReportServer\\bin\\ReportingServicesService.exe" },
    { "probeType": "path", "value": "C:\\Program Files\\Microsoft SQL Server\\170\\DTS\\Binn\\MsDtsSrvr.exe" }
  ]
}
